# Gộp block này vào Caddyfile hiện tại. KHÔNG xóa cấu hình Gunny.
# DNS minisocial.xubi.org phải trỏ về IPv4 Public của Pi/router; NAT 443 -> Pi.
# Nếu Tailscale Serve đang dùng 443 trên tailscale0, cấu hình bind IP LAN
# phù hợp theo giao diện Xubi Network / NAT trước khi bật Caddy.
minisocial.xubi.org {
    encode gzip
    # Backend MiniSocial phục vụ cả trang tải, JAR/JAD và API trên cùng cổng.
    reverse_proxy 127.0.0.1:18087
}

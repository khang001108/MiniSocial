# MiniSocial v1.7.0 - set only in Xubi Environment or server-side .env, NEVER git commit secrets.
PORT=8080
SUPABASE_URL=https://YOUR_MINISOCIAL_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# Admin login is independent from Supabase. Use >= 16 random characters.
MINISOCIAL_ADMIN_USER=admin
MINISOCIAL_ADMIN_PASSWORD=SET_A_LONG_RANDOM_PASSWORD
